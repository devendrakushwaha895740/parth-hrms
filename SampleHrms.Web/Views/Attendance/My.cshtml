@model IEnumerable<SampleHrms.Web.ViewModels.AttendanceViewModel>
@{ ViewData["Title"] = "My attendance"; ViewData["AgentPage"] = "attendance-my"; }
<h2 data-agent-id="attendance-my-title">My attendance</h2>
<table class="table" data-agent-id="attendance-my-table"><thead><tr><th>Date</th><th>Check in</th><th>Check out</th><th>Status</th></tr></thead><tbody>
@foreach (var r in Model) { <tr data-agent-id="attendance-my-row-@r.Id"><td>@r.Date:d</td><td>@(r.CheckIn?.ToString(@"hh\:mm"))</td><td>@(r.CheckOut?.ToString(@"hh\:mm"))</td><td>@r.Status</td></tr> }
</tbody></table>
