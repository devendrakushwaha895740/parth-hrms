@model SampleHrms.Web.ViewModels.CreateEmployeeViewModel
@{ ViewData["Title"] = "Create employee"; ViewData["AgentPage"] = "employee-create"; }
<h2 data-agent-id="employee-create-title">Create account</h2>
<form asp-action="Create" method="post" data-agent-id="employee-create-form">
 <div asp-validation-summary="ModelOnly" class="text-danger"></div>
 <div class="mb-3"><label asp-for="FullName" class="form-label"></label><input asp-for="FullName" class="form-control" data-agent-id="employee-full-name" /></div>
 <div class="mb-3"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" data-agent-id="employee-email" /></div>
 <div class="row"><div class="col-md-6 mb-3"><label asp-for="EmployeeCode" class="form-label"></label><input asp-for="EmployeeCode" class="form-control" data-agent-id="employee-code" /></div><div class="col-md-6 mb-3"><label asp-for="Department" class="form-label"></label><input asp-for="Department" class="form-control" data-agent-id="employee-department" /></div></div>
 <div class="mb-3"><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control" data-agent-id="employee-password" /></div>
 <div class="mb-3"><label asp-for="Role" class="form-label"></label><select asp-for="Role" class="form-select" data-agent-id="employee-role"><option>Employee</option><option>HR</option><option>Admin</option></select></div>
 <button type="submit" class="btn btn-primary" data-agent-id="employee-create-submit">Create</button>
</form>
